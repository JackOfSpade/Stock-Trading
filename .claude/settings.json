{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Google-Calendar__list_events",
      "mcp__Google-Calendar__create_event",
      "mcp__Google-Calendar__delete_event",
      "mcp__Google-Calendar__update_event",
      "mcp__Google-Calendar__get_event",
      "mcp__Google_Calendar__list_events",
      "mcp__Google_Calendar__create_event",
      "mcp__Google_Calendar__delete_event",
      "mcp__Google_Calendar__update_event",
      "mcp__Google_Calendar__get_event",
      "mcp__Google_Calendar__list_calendars",
      "mcp__Google_Calendar__respond_to_event",
      "mcp__Google_Calendar__suggest_time"
    ]
  }
}
