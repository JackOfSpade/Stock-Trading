.claude/settings.local.json
# ...and any backup of it. The permission-rule edit recipe in this repo copies the file to
# .bak first; that copy is local machine config (it lists granted Bash/MCP permissions) and
# must never land in the repo. The bare path above does not glob, so it did not cover it.
.claude/settings.local.json.*
.DS_Store

# BigQuery migration intermediates (derived data, not source)
bigquery/out/

# Generated trading-state dumps — positions / NAV / account_reconciliation /
# health. Derived from BigQuery, sensitive, and NOT source. Produced by
# scripts/state_snapshot.sh and ops/dashboard/generate_dashboard.py; must never
# be committed (would expose live trading data if repo visibility ever changed).
state_snapshots/
ops/dashboard/index.html

# Retired adversarial-review transcript duplicates. Canonical bodies are in
# events.adversarial_reviews; use an explicit export if a Markdown copy is needed.
/Adversarial_Review_*.md

# Python bytecode
__pycache__/
*.pyc

# Credentials (paranoia)
creds/
*sa_key*.json
b14575dd-*

# local CI secrets for act (global pre-push hook) - never commit
.secrets

# BUG FIX (2026-08-31 code-quality pass): terraform.tfvars.example claims "terraform.tfvars is
# git-ignored by convention" but no rule for it existed here — a `cp ... terraform.tfvars` +
# `git add -A` could have committed a real billing_account id. Also ignore Terraform's local
# state/plugin-cache dirs, which likewise must never be committed (the real state backend is
# gs://stock-trading-tfstate, per infra/terraform's declared-spec-only posture in CLAUDE.md).
infra/terraform/terraform.tfvars
infra/terraform/.terraform/
infra/terraform/*.tfstate*
